# ==============================================================================
# BIẾN MÔI TRƯỜNG MẪU CHO BACKEND (FASTAPI)
# Sao chép file này thành .env trong thư mục xeghep-backend/:
# cp .env.example .env
# ==============================================================================

# Bỏ chú thích PORT nếu muốn ép cổng cố định (mặc định: 10000 với python3 main.py, 8000 với uvicorn)
# PORT=8000
DB_TYPE=sqlite

# MYSQL_HOST=127.0.0.1
# MYSQL_PORT=3306
# MYSQL_USER=root
# MYSQL_PASSWORD=
# MYSQL_DB=xeghep_db

AI_PROVIDER=gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-20b

MATCH_INTERVAL_MINUTES=30
AUTO_START_CRAWLERS=false

FB_COOKIE=
THREADS_COOKIE=
ZALO_COOKIES=
