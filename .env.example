# ==============================================================================
# BIẾN MÔI TRƯỜNG MẪU CHO DỰ ÁN XE TIỆN CHUYẾN
# Hướng dẫn: Sao chép file này thành .env (hoặc xeghep-backend/.env) và điền cấu hình:
# cp .env.example .env
# ==============================================================================

# --- 1. CẤU HÌNH SERVER & CỔNG CHẠY ---
# Bỏ trống/chú thích để dùng mặc định: 10000 khi chạy `python3 main.py`, hoặc 8000 khi chạy `uvicorn` dev.
# PORT=10000
# BACKEND_API_URL=http://127.0.0.1:10000/api/crawler/posts

# --- 2. CẤU HÌNH CƠ SỞ DỮ LIỆU ---
# DB_TYPE: "sqlite" (chạy nhẹ nhàng cục bộ, không cần cài đặt thêm)
#          "mysql" (kết nối CSDL TiDB Cloud hoặc MySQL Server)
DB_TYPE=sqlite

# Nếu dùng MySQL hoặc TiDB Cloud, bỏ chú thích và điền thông số:
# MYSQL_HOST=gateway01.ap-southeast-1.prod.aws.tidbcloud.com
# MYSQL_PORT=4000
# MYSQL_USER=your_username.root
# MYSQL_PASSWORD=your_password
# MYSQL_DB=xeghep_db

# --- 3. CẤU HÌNH TRÍ TUỆ NHÂN TẠO (AI MODEL) ---
# AI_PROVIDER: "gemini" | "openai" | "groq" (Mặc định: gemini)
AI_PROVIDER=gemini

# Google Gemini API Key (Lấy miễn phí tại: https://aistudio.google.com/)
GEMINI_API_KEY=
# Hỗ trợ xoay vòng nhiều key để tránh chạm giới hạn hạn ngạch (Rate Limit):
GEMINI_API_KEY_1=
GEMINI_API_KEY_2=
GEMINI_MODEL=gemini-2.5-flash

# OpenAI API Key (Nếu chọn AI_PROVIDER=openai)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Groq API Key (Nếu chọn AI_PROVIDER=groq)
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-20b

# Chu kỳ tự động quét và ghép chuyến thông minh (phút)
MATCH_INTERVAL_MINUTES=30

# --- 4. CẤU HÌNH BOT CÀO DỮ LIỆU TỰ ĐỘNG (CRAWLER BOTS) ---
# Bật/Tắt tự động chạy bot khi khởi động server: true / false
AUTO_START_CRAWLERS=false

# Cookie tài khoản Facebook để cào nhóm xe ghép liên tỉnh (bỏ trống nếu không dùng bot)
FB_COOKIE=
FB_CRAWL_INTERVAL=1800

# Cookie tài khoản Threads (bỏ trống nếu không dùng)
THREADS_COOKIE=
THREADS_CRAWL_INTERVAL=1800

# Cookie tài khoản Zalo (bỏ trống nếu không dùng)
ZALO_COOKIES=
ZALO_CRAWL_INTERVAL=1800
